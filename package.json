{
  "name": "power-exit",
  "version": "0.1.0",
  "private": true,
  "description": "Power Platform migration assessment and Azure artefact generation engine",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist coverage .eslintcache apps/*/dist packages/*/dist",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.3"
  }
}
