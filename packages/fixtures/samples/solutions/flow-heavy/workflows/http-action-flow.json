{
  "name": "http-action-flow",
  "properties": {
    "displayName": "HTTP Action Flow",
    "state": "Started",
    "definition": {
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {}
        }
      },
      "actions": {
        "invoke_api": {
          "type": "Http",
          "runAfter": {},
          "inputs": {
            "method": "GET",
            "uri": "@{variables('ENV_API_BASE')}/health"
          }
        }
      },
      "outputs": {}
    }
  }
}
