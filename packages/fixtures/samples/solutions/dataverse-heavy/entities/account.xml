<Entity>
  <LogicalName>account</LogicalName>
  <SchemaName>Account</SchemaName>
  <DisplayName>Account</DisplayName>
  <OwnershipType>UserOwned</OwnershipType>
  <PrimaryNameAttribute>name</PrimaryNameAttribute>
  <PrimaryIdAttribute>accountid</PrimaryIdAttribute>
  <Attributes>
    <Attribute>
      <LogicalName>accountid</LogicalName>
      <SchemaName>AccountId</SchemaName>
      <Type>UniqueIdentifier</Type>
      <RequiredLevel>SystemRequired</RequiredLevel>
    </Attribute>
    <Attribute>
      <LogicalName>name</LogicalName>
      <SchemaName>Name</SchemaName>
      <Type>String</Type>
      <RequiredLevel>ApplicationRequired</RequiredLevel>
      <MaxLength>160</MaxLength>
    </Attribute>
    <Attribute>
      <LogicalName>revenue</LogicalName>
      <SchemaName>Revenue</SchemaName>
      <Type>Money</Type>
      <RequiredLevel>None</RequiredLevel>
      <Precision>2</Precision>
      <Scale>2</Scale>
    </Attribute>
  </Attributes>
  <Relationships>
    <OneToMany>
      <Relationship>
        <SchemaName>account_contacts</SchemaName>
        <FromEntity>account</FromEntity>
        <ToEntity>contact</ToEntity>
      </Relationship>
    </OneToMany>
    <ManyToOne>
      <Relationship>
        <SchemaName>parent_account</SchemaName>
        <FromEntity>account</FromEntity>
        <ToEntity>account</ToEntity>
      </Relationship>
    </ManyToOne>
  </Relationships>
  <OptionSets>
    <OptionSet>
      <LogicalName>account_status</LogicalName>
      <IsGlobal>false</IsGlobal>
      <Options>
        <Option>
          <Value>1</Value>
          <Label>Active</Label>
        </Option>
        <Option>
          <Value>2</Value>
          <Label>Inactive</Label>
        </Option>
      </Options>
    </OptionSet>
  </OptionSets>
</Entity>
